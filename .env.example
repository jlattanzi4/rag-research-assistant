# RAG Research Assistant Configuration
# Copy this file to .env (no changes needed for free local setup!)

# ===========================================
# Ollama Settings (FREE, LOCAL)
# ===========================================
# Ollama runs locally - no API key needed!
# Just install Ollama and pull a model

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ===========================================
# Embedding Settings (FREE, LOCAL)
# ===========================================
# Uses HuggingFace sentence-transformers locally

EMBEDDING_MODEL=all-MiniLM-L6-v2

# ===========================================
# LLM Generation Settings
# ===========================================
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# ===========================================
# Chunking Settings
# ===========================================
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# ===========================================
# Vector Store Settings
# ===========================================
CHROMA_PERSIST_DIRECTORY=./data/chroma
COLLECTION_NAME=research_papers

# ===========================================
# Retrieval Settings
# ===========================================
TOP_K=5
SIMILARITY_THRESHOLD=0.7

# ===========================================
# Optional: Paid API Keys (uncomment to use)
# ===========================================
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# OPENAI_API_KEY=sk-your-key-here
